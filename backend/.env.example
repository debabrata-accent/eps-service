# ─── Backend environment variables ───────────────────────────────────────────
# Copy to .env for local dev. On Railway/Render, set these in the dashboard.

PORT=5000
NODE_ENV=development

# MongoDB — leave EMPTY locally to use the in-memory DB.
# In production, use your MongoDB Atlas connection string.
MONGODB_URI=

# JWT secrets — use long random strings in production
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret

# Allowed frontend origin(s), comma-separated (no trailing slash).
# Production example: https://yourdomain.com
# You can include localhost too: https://yourdomain.com,http://localhost:5173
CLIENT_URL=http://localhost:5173

# Cloudinary (file uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay (payments)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Firebase Admin (push notifications) — paste the full service-account JSON on one line
FIREBASE_SERVICE_ACCOUNT_JSON=
